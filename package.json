    "index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "nhtsa",
    "recalls",
    "vin",
    "vin-decoder",
    "vehicles",
    "cars",
    "service-bulletins",
    "tsb",
    "obd2",
    "dtc",
    "epa",
    "automotive"
  ],
  "homepage": "https://whichtrim.com/developers/#mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BabbagesCabbages/whichtrim-mcp.git"
  },
