{
  "name": "whichtrim-mcp",
  "version": "1.0.0",
  "description": "MCP server for U.S. vehicle records: NHTSA recalls, complaints, investigations, service bulletins, trouble codes, EPA fuel economy, crash ratings and trim-level specs, by model year or VIN. Public data, no API key.",
